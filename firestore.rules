rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
      match /pets/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
            match /locations/{locId} {
            allow read : if request.auth != null && request.auth.uid == uid;
      }
    }
  }
 }
}
